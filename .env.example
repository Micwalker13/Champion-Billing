DATABASE_URL=postgres://postgres:postgres@localhost:5432/champion
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=production

# Hosted Postgres (Supabase): paste the provider's root certificate (PEM) for verified TLS.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# First-run /setup page (only works while there are no users). 16+ random characters.
# SETUP_TOKEN=
# Upload size limit in MB (default 15; 4 on Vercel)
# MAX_UPLOAD_MB=

# Emailing invoices (optional; the Email buttons stay hidden until these are set).
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_USER/INVOICE_FROM = the mailbox, SMTP_PASS = its password
# (the mailbox needs "Authenticated SMTP" turned on in Microsoft 365 admin).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# INVOICE_FROM="Champion Equipment Billing <billing@championequipmentco.com>"
# INVOICE_REPLY_TO=
