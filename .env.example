DATABASE_URL=postgres://postgres:postgres@localhost:5432/champion
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=production

# Hosted Postgres (Supabase): paste the provider's root certificate (PEM) for verified TLS.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# First-run /setup page (only works while there are no users). 16+ random characters.
# SETUP_TOKEN=
# Upload size limit in MB (default 15; 4 on Vercel)
# MAX_UPLOAD_MB=
